{
  "name": "qwykz",
  "version": "1.4.3",
  "description": "Fast Express + TypeScript + Prisma boilerplate generator built with Bun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcZxc1/qwykz.git"
  },
  "keywords": [
    "boilerplate",
    "scaffold",
    "generator",
    "cli",
    "express",
    "typescript",
    "bun",
    "prisma",
    "postgresql",
    "mvc",
    "rest",
    "api",
    "jwt",
    "authentication",
    "argon2",
    "docker"
  ],
  "license": "MIT",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "qwykz": "src/index.ts"
  },
  "files": [
    "src/",
    "templates/",
    "scripts/",
    "skills/",
    "docs/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "tsconfig.json",
    "bun.lock"
  ],
  "scripts": {
    "build:bin": "bun run scripts/build-bin.ts",
    "test": "bun test --timeout 180000 tests/template-engine.test.ts && bun test --timeout 180000 tests/cli.test.ts && bun test --timeout 180000 tests/e2e.test.ts && bun test --timeout 180000 tests/full-matrix.test.ts",
    "test:runtime": "QWYKZ_RUN_RUNTIME_SMOKE=1 bun test --timeout 900000 tests/runtime-smoke.test.ts",
    "test:runtime:laravel": "QWYKZ_RUN_RUNTIME_SMOKE=1 QWYKZ_SMOKE_INCLUDE_EXTERNAL=1 QWYKZ_SMOKE_FILTER=laravel bun test --timeout 900000 tests/runtime-smoke.test.ts",
    "test:managed": "QWYKZ_RUN_MANAGED_CREDENTIAL_SMOKE=1 bun test --timeout 180000 tests/managed-credentials.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/node": "^25.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "cors": "^2.8.6",
    "picocolors": "^1.1.1"
  }
}
